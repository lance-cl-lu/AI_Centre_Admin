From 56f7bf58c2b89a1f0a2d66fd16e7fe25d0c5ce3a Mon Sep 17 00:00:00 2001
From: MarkJiang-maji <chiang142536@gmail.com>
Date: Fri, 20 Nov 2026 00:46:30 +0800
Subject: [PATCH 13/19] Let the backend move namespaceAdmin to a user's new
 email

Same change as AI_Centre_Admin AI_LDAP_admin/cluster-role.yaml. Changing a
user's email now replaces the namespace's namespaceAdmin RoleBinding subject;
without these rules every email change fails with 403 after the Profile owner
was already changed. bind on kubeflow-admin is needed because updating a
binding is checked for privilege escalation. Both rules are limited by
resourceNames. kubectl diff on .4 and .6: only these two rules are added.
---
 .../overlays/ldap-backend/cluster-role.yaml   | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/common/dex/overlays/ldap-backend/cluster-role.yaml b/common/dex/overlays/ldap-backend/cluster-role.yaml
index 088533b5..76b26635 100644
--- a/common/dex/overlays/ldap-backend/cluster-role.yaml
+++ b/common/dex/overlays/ldap-backend/cluster-role.yaml
@@ -20,6 +20,26 @@ rules:
   - delete
   - patch
   - update
+# Changing a user's email moves the namespace's namespaceAdmin RoleBinding to the new
+# address (api/views.py update_profile_owner_email). Updating a binding is checked for
+# privilege escalation, so the backend also needs bind on the role it references.
+- apiGroups:
+  - rbac.authorization.k8s.io
+  resources:
+  - rolebindings
+  resourceNames:
+  - namespaceAdmin
+  verbs:
+  - get
+  - update
+- apiGroups:
+  - rbac.authorization.k8s.io
+  resources:
+  - clusterroles
+  resourceNames:
+  - kubeflow-admin
+  verbs:
+  - bind
 - apiGroups:
   - kubeflow.org  
   resources:
-- 
