From 3ce77cc9d0af054d773cfb80f6cc2b76229c149e Mon Sep 17 00:00:00 2001
From: MarkJiang-maji <chiang142536@gmail.com>
Date: Mon, 12 Oct 2026 21:05:55 +0800
Subject: [PATCH 06/19] apply.sh: escape | as well when writing NFS values with
 sed

The escaping turned & into \\& (breaking the YAML line) and left | alone,
although the seds use | as delimiter.
---
 apply.sh | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/apply.sh b/apply.sh
index 3aa4bcdc..8f3c9df6 100755
--- a/apply.sh
+++ b/apply.sh
@@ -47,8 +47,8 @@ if [ -z "$QNAP_NFS_DEPLOYMENT" ]; then
 fi
 
 escape_sed_replacement() {
-  # Escape replacement text for sed (& and backslash).
-  printf '%s' "$1" | sed -e 's/[&\\]/\\\\&/g'
+  # Escape replacement text for sed: & and backslash, plus | because the seds below use it as delimiter.
+  printf '%s' "$1" | sed -e 's/[&\\|]/\\&/g'
 }
 
 GROUPSHARE_CONTROLLER_DEPLOY="cgu/groupshare/deploy/controller-deployment.yaml"
-- 
2.43.0

